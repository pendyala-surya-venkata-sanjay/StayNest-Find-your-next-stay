# ==============================================================================
# STAYNEST ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your respective service environments.
# Do NOT commit raw production secrets/passwords to git repository.

# ------------------------------------------------------------------------------
# BACKEND API CONFIGURATIONS
# ------------------------------------------------------------------------------
# Database Connection URI (SQLite local fallback vs hosted PostgreSQL)
# Local: sqlite:///./airbnb.db
# Render/Prod: postgresql://username:password@hostname:port/database
DATABASE_URL=sqlite:///./airbnb.db

# JWT Security Key (Required in Production, fails if unset in RENDER/PostgreSQL envs)
JWT_SECRET=your_jwt_secret_key_here

# Deploy origin URL of the Frontend (used for CORS mapping validation)
FRONTEND_URL=http://localhost:3000

# Optional port setting for local backend uvicorn bindings
# PORT=8000

# ------------------------------------------------------------------------------
# FRONTEND NEXT.JS CONFIGURATIONS
# ------------------------------------------------------------------------------
# API address targeted by client browser operations
NEXT_PUBLIC_API_URL=http://localhost:8000
